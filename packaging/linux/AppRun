#!/bin/sh
# NeverRed — lanzador Linux (AppImage). Arranca el servidor (o lo reutiliza)
# y abre el navegador. Sin dependencias: python3 del sistema + navegador.
# Uso: NeverRed-*.AppImage [--stop]   (PID guardado para no duplicar)
set -u
HERE="$(cd "$(dirname "$0")" && pwd)"
APP="$HERE/app"
DATA="${XDG_DATA_HOME:-$HOME/.local/share}/NeverRed"
PORT="${PORT:-8000}"
URL="http://127.0.0.1:$PORT"
PIDF="$DATA/server.pid"
mkdir -p "$DATA"

# Solo señaliza el PID si de verdad es nuestro server.py (un pidfile rancio
# podría apuntar a otro proceso por reutilización de PIDs).
stop_server() { # $1=pidfile
  [ -f "$1" ] || return 1
  PID="$(cat "$1" 2>/dev/null)"
  case "$PID" in ''|*[!0-9]*) rm -f "$1"; return 1 ;; esac
  if ps -p "$PID" -o command= 2>/dev/null | grep -q 'server\.py'; then
    kill "$PID" 2>/dev/null
  fi
  rm -f "$1"
}

if [ "${1:-}" = "--stop" ]; then
  if stop_server "$PIDF"; then echo "NeverRed detenido."; else echo "No estaba en marcha."; fi
  exit 0
fi

abrir() {
  [ "${NEVERRED_NO_BROWSER:-0}" = "1" ] && return 0
  if command -v xdg-open >/dev/null 2>&1; then xdg-open "$URL" 2>/dev/null
  elif command -v open >/dev/null 2>&1; then open "$URL" 2>/dev/null
  else python3 -m webbrowser "$URL" 2>/dev/null; fi
}

if [ -f "$PIDF" ] && kill -0 "$(cat "$PIDF")" 2>/dev/null \
   && curl -sf -o /dev/null "$URL/api/health" 2>/dev/null; then
  : # reutilización más abajo, tras comprobar actualizaciones
  REUSE=1
else
  REUSE=0
fi

# Actualizaciones: si instala una nueva, la abre y salimos
if [ -x "$HERE/check-update.sh" ]; then
  UPD=0
  "$HERE/check-update.sh" "$HERE" "$DATA" || UPD=$?
  if [ "$UPD" -eq 42 ]; then exit 0; fi
fi

if [ "$REUSE" = "1" ]; then
  abrir  # ya estaba en marcha: solo abre el navegador
  exit 0
fi

if command -v python3 >/dev/null 2>&1; then PY=python3; else echo "Falta python3 en el sistema."; exit 1; fi
export NEVERRED_DB="$DATA/neverred.db" HOST=127.0.0.1 PORT="$PORT"
# Telemetría: destino por defecto inyectado al construir el paquete (vacío en
# releases públicas). Prioridad: entorno > telemetry.conf > defecto del build.
_SINK_DEF="__NEVERRED_BUILD_SINK__"
_TOKEN_DEF="__NEVERRED_BUILD_TOKEN__"
case "$_SINK_DEF" in __*) _SINK_DEF="";; esac
case "$_TOKEN_DEF" in __*) _TOKEN_DEF="";; esac
if [ -z "${NEVERRED_TELEMETRY_SINK:-}" ]; then
  if [ -f "$DATA/telemetry.conf" ]; then
    NEVERRED_TELEMETRY_SINK="$(sed -n 's/^NEVERRED_TELEMETRY_SINK=//p' "$DATA/telemetry.conf" | head -1)"
  fi
  : "${NEVERRED_TELEMETRY_SINK:=$_SINK_DEF}"
  export NEVERRED_TELEMETRY_SINK
fi
if [ -z "${NEVERRED_TELEMETRY_TOKEN:-}" ]; then
  if [ -f "$DATA/telemetry.conf" ]; then
    NEVERRED_TELEMETRY_TOKEN="$(sed -n 's/^NEVERRED_TELEMETRY_TOKEN=//p' "$DATA/telemetry.conf" | head -1)"
  fi
  : "${NEVERRED_TELEMETRY_TOKEN:=$_TOKEN_DEF}"
  export NEVERRED_TELEMETRY_TOKEN
fi
export NEVERRED_QUIT_WHEN_IDLE=1 NEVERRED_IDLE_TIMEOUT=20
"$PY" "$APP/backend/server.py" >"$DATA/server.log" 2>&1 &
SRV=$!
echo $SRV > "$PIDF"
# Al cerrar la AppImage se detiene el servidor: sin actividad oculta.
trap 'kill $SRV 2>/dev/null; rm -f "$PIDF"; exit 0' TERM INT
i=0
while [ $i -lt 20 ]; do
  curl -sf -o /dev/null "$URL/api/health" 2>/dev/null && break
  sleep 0.5; i=$((i + 1))
done
abrir
wait $SRV
